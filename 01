import tkinter as tk
from tkinter import ttk, messagebox
import sqlite3

# Настройки темной темы
DARK_BG = "#1e1e1e"
DARK_FG = "#ffffff"
DARK_INPUT = "#333333"
ACCENT_COLOR = "#bb86fc"
STATUS_OPTIONS = ["Записан", "Подтвержден", "На приеме", "Закрыто", "Неявка"]

class ClinicApp:
    def __init__(self, root):
        self.root = root
        self.root.title("ИС 'Регистратура' - Расширенная версия")
        self.root.geometry("1000x700")
        self.root.configure(bg=DARK_BG)
        
        # Настройка масштабирования окна
        self.root.columnconfigure(0, weight=1)
        self.root.rowconfigure(0, weight=1)
        
        self.init_db()
        self.setup_styles()
        self.create_widgets()
        self.update_table()

    def init_db(self):
        conn = sqlite3.connect('clinic_pro.db')
        cursor = conn.cursor()
        cursor.execute('''CREATE TABLE IF NOT EXISTS patients (
                            id INTEGER PRIMARY KEY, 
                            fio TEXT, dob TEXT, phone TEXT, 
                            visit_date TEXT, visit_time TEXT,
                            tests TEXT, sick_leave TEXT, status TEXT)''')
        conn.commit()
        conn.close()

    def setup_styles(self):
        style = ttk.Style()
        style.theme_use('clam')
        # Стили таблицы
        style.configure("Treeview", background=DARK_INPUT, foreground=DARK_FG, fieldbackground=DARK_INPUT, borderwidth=0)
        style.map("Treeview", background=[('selected', ACCENT_COLOR)])
        style.configure("Treeview.Heading", background="#333333", foreground=DARK_FG, borderwidth=0)
        # Стили выпадающего списка
        style.configure("TCombobox", fieldbackground=DARK_INPUT, background=DARK_INPUT, foreground=DARK_FG)

    def create_widgets(self):
        # Основной контейнер с весами
        main_frame = tk.Frame(self.root, bg=DARK_BG, padx=15, pady=15)
        main_frame.grid(row=0, column=0, sticky="nsew")
        main_frame.columnconfigure(0, weight=1)
        main_frame.columnconfigure(1, weight=1)
        main_frame.rowconfigure(2, weight=1) # Таблица будет тянуться

        # Левая колонка: Данные
        data_frame = tk.LabelFrame(main_frame, text="Карточка пациента", bg=DARK_BG, fg=ACCENT_COLOR, padx=10, pady=10)
        data_frame.grid(row=0, column=0, sticky="nsew", padx=5)

        self.fields = {}
        labels = [("ФИО", "fio"), ("Дата рожд.", "dob"), ("Телефон", "phone"), 
                  ("Дата приема", "v_date"), ("Время приема", "v_time")]
        
        for i, (label, key) in enumerate(labels):
            tk.Label(data_frame, text=label, bg=DARK_BG, fg=DARK_FG).grid(row=i, column=0, sticky="w", pady=2)
            entry = tk.Entry(data_frame, bg=DARK_INPUT, fg=DARK_FG, insertbackground="white", borderwidth=0)
            entry.grid(row=i, column=1, pady=2, padx=5, sticky="ew")
            self.fields[key] = entry
        data_frame.columnconfigure(1, weight=1)

        # Правая колонка: Анализы, Больничный и СТАТУС
        action_frame = tk.LabelFrame(main_frame, text="Назначения и Статус", bg=DARK_BG, fg=ACCENT_COLOR, padx=10, pady=10)
        action_frame.grid(row=0, column=1, sticky="nsew", padx=5)

        # Анализы
        tk.Label(action_frame, text="Анализы:", bg=DARK_BG, fg=DARK_FG).pack(anchor="w")
        self.tests_vars = {t: tk.BooleanVar() for t in ["Кровь", "Моча", "Кал"]}
        for text, var in self.tests_vars.items():
            tk.Checkbutton(action_frame, text=text, variable=var, bg=DARK_BG, fg=DARK_FG, 
                           selectcolor=DARK_INPUT, activebackground=DARK_BG).pack(anchor="w")

        # Больничный
        tk.Label(action_frame, text="Больничный лист:", bg=DARK_BG, fg=DARK_FG, pady=5).pack(anchor="w")
        self.sick_var = tk.StringVar(value="Нет")
        for s in ["Открыт", "Продлен", "Закрыт", "Нет"]:
            tk.Radiobutton(action_frame, text=s, variable=self.sick_var, value=s, 
                           bg=DARK_BG, fg=DARK_FG, selectcolor=DARK_INPUT).pack(anchor="w")

        # Статус записи (Новое)
        tk.Label(action_frame, text="Статус приема:", bg=DARK_BG, fg=ACCENT_COLOR, pady=5).pack(anchor="w")
        self.status_combo = ttk.Combobox(action_frame, values=STATUS_OPTIONS, state="readonly")
        self.status_combo.set(STATUS_OPTIONS[0])
        self.status_combo.pack(fill="x", pady=5)

        # Кнопки
        btn_frame = tk.Frame(main_frame, bg=DARK_BG)
        btn_frame.grid(row=1, column=0, columnspan=2, pady=15)

        tk.Button(btn_frame, text="💾 Сохранить", command=self.add_entry, bg="#388E3C", fg="white", width=15).pack(side="left", padx=5)
        tk.Button(btn_frame, text="🔄 Обновить", command=self.update_status, bg="#1976D2", fg="white", width=15).pack(side="left", padx=5)
        tk.Button(btn_frame, text="🗑 Удалить", command=self.delete_entry, bg="#D32F2F", fg="white", width=15).pack(side="left", padx=5)

        # Таблица
        cols = ("id", "fio", "date", "time", "tests", "sick", "status")
        self.tree = ttk.Treeview(main_frame, columns=cols, show="headings")
        for col in cols: 
            self.tree.heading(col, text=col.upper())
            self.tree.column(col, minwidth=50, width=100, stretch=True)
        self.tree.grid(row=2, column=0, columnspan=2, sticky="nsew")

    def add_entry(self):
        tests_selected = ", ".join([t for t, v in self.tests_vars.items() if v.get()])
        data = (
            self.fields['fio'].get(), self.fields['dob'].get(), self.fields['phone'].get(),
            self.fields['v_date'].get(), self.fields['v_time'].get(),
            tests_selected, self.sick_var.get(), self.status_combo.get()
        )
        if not data[0]: 
            messagebox.showerror("Ошибка", "Заполните ФИО")
            return
            
        conn = sqlite3.connect('clinic_pro.db')
        cursor = conn.cursor()
        cursor.execute("INSERT INTO patients (fio, dob, phone, visit_date, visit_time, tests, sick_leave, status) VALUES (?,?,?,?,?,?,?,?)", data)
        conn.commit()
        conn.close()
        self.update_table()

    def update_status(self):
        selected = self.tree.selection()
        if not selected:
            messagebox.showwarning("Внимание", "Выберите запись в таблице")
            return
        p_id = self.tree.item(selected)['values'][0]
        tests_selected = ", ".join([t for t, v in self.tests_vars.items() if v.get()])
        
        conn = sqlite3.connect('clinic_pro.db')
        cursor = conn.cursor()
        cursor.execute("UPDATE patients SET tests=?, sick_leave=?, visit_date=?, visit_time=?, status=? WHERE id=?", 
                       (tests_selected, self.sick_var.get(), self.fields['v_date'].get(), self.fields['v_time'].get(), self.status_combo.get(), p_id))
        conn.commit()
        conn.close()
        self.update_table()

    def delete_entry(self):
        selected = self.tree.selection()
        if not selected:
            messagebox.showwarning("Внимание", "Выберите запись для удаления")
            return
        if messagebox.askyesno("Подтверждение", "Удалить выбранную запись?"):
            p_id = self.tree.item(selected)['values'][0]
            conn = sqlite3.connect('clinic_pro.db')
            cursor = conn.cursor()
            cursor.execute("DELETE FROM patients WHERE id=?", (p_id,))
            conn.commit()
            conn.close()
            self.update_table()

    def update_table(self):
        for i in self.tree.get_children(): self.tree.delete(i)
        conn = sqlite3.connect('clinic_pro.db')
        cursor = conn.cursor()
        for row in cursor.execute("SELECT id, fio, visit_date, visit_time, tests, sick_leave, status FROM patients"):
            self.tree.insert("", "end", values=row)
        conn.close()

if __name__ == "__main__":
    root = tk.Tk()
    app = ClinicApp(root)
    root.mainloop()
