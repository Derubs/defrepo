import tkinter as tk
from tkinter import ttk

class MedodsApp(tk.Tk):
    def init(self):
        super().init()
        
        self.title("Медицинская информационная система (Прототип)")
        self.geometry("1200x800")
        self.configure(bg="#ecf0f1")
        
        # Настройка стилей
        self.style = ttk.Style()
        self.style.theme_use('clam')
        
        # Основные цвета из скриншота
        self.COLOR_HEADER_BG = "#2c3e50"
        self.COLOR_SIDEBAR_BG = "#ffffff"
        self.COLOR_ACCENT = "#3498db"
        
        self.create_header()
        self.create_main_layout()

    def create_header(self):
        """Верхняя панель (Шапка)"""
        header_frame = tk.Frame(self, bg=self.COLOR_HEADER_BG, height=50)
        header_frame.pack(side=tk.TOP, fill=tk.X)
        header_frame.pack_propagate(False)
        
        # Логотип
        lbl_logo = tk.Label(header_frame, text="MEDODS", bg=self.COLOR_HEADER_BG, fg="white", font=("Arial", 16, "bold"))
        lbl_logo.pack(side=tk.LEFT, padx=20)
        
        # Инфо пользователя (справа)
        lbl_user = tk.Label(header_frame, text="Клиника1 | Иванов Павел", bg=self.COLOR_HEADER_BG, fg="white", font=("Arial", 10))
        lbl_user.pack(side=tk.RIGHT, padx=20)

    def create_main_layout(self):
        """Создание 3-х основных колонок: Левая (Врачи), Центр (Расписание), Правая (Календарь)"""
        main_frame = tk.Frame(self, bg="#ecf0f1")
        main_frame.pack(side=tk.TOP, fill=tk.BOTH, expand=True, padx=10, pady=10)
        
        self.create_left_sidebar(main_frame)
        self.create_right_sidebar(main_frame)
        self.create_center_schedule(main_frame) # Центральная часть создается последней, чтобы занять оставшееся место

    def create_left_sidebar(self, parent):
        """Левая панель со списком специальностей и врачей"""
        left_frame = tk.Frame(parent, bg=self.COLOR_SIDEBAR_BG, width=220, highlightbackground="#bdc3c7", highlightthickness=1)
        left_frame.pack(side=tk.LEFT, fill=tk.Y, padx=(0, 10))
        left_frame.pack_propagate(False)
        
        # Заголовок
        lbl_title = tk.Label(left_frame, text="Врачи", bg="#3498db", fg="white", font=("Arial", 11, "bold"), pady=5)
        lbl_title.pack(fill=tk.X)
        
        # Список специальностей (имитация кнопок)
        specialties = ["Все", "Гастроэнтеролог", "Инфекционист", "Кардиолог", "Терапевт", "УЗИ врач", "Хирург"]
        for spec in specialties:
            bg_color = "#3498db" if spec != "Все" else "#2980b9"
            btn = tk.Button(left_frame, text=spec, bg=bg_color, fg="white", relief=tk.FLAT, anchor="w", padx=10)
            btn.pack(fill=tk.X, pady=1)
            
        # Разделитель
        ttk.Separator(left_frame, orient='horizontal').pack(fill=tk.X, pady=10)
        
        # Чекбоксы врачей
        doctors = ["Баранов И. Е.", "Тарасов Р. Т.", "Иванов П. В.", "Комаров Р. В.", "Семёнов Н. В."]
        for doc in doctors:
            var = tk.BooleanVar(value=True if "Баранов" in doc or "Тарасов" in doc or "Иванов" in doc else False)
            chk = tk.Checkbutton(left_frame, text=doc, variable=var, bg=self.COLOR_SIDEBAR_BG, anchor="w")
            chk.pack(fill=tk.X, padx=10)

    def create_right_sidebar(self, parent):
        """Правая панель с календарем и настройками сетки"""
        right_frame = tk.Frame(parent, bg=self.COLOR_SIDEBAR_BG, width=250, highlightbackground="#bdc3c7", highlightthickness=1)
        right_frame.pack(side=tk.RIGHT, fill=tk.Y, padx=(10, 0))
        right_frame.pack_propagate(False)
        
        # Заголовок
        lbl_title = tk.Label(right_frame, text="Календарь", bg="#3498db", fg="white", font=("Arial", 11, "bold"), pady=5)
        lbl_title.pack(fill=tk.X)
        
        # Заглушка для календаря (в реальном проекте используйте библиотеку tkcalendar)

lbl_cal = tk.Label(right_frame, text="[ Здесь должен быть виджет\nкалендаря tkcalendar ]", bg="#f8f9fa", height=10)
        lbl_cal.pack(fill=tk.X, padx=5, pady=5)
        
        # Настройки шага сетки
        tk.Label(right_frame, text="Шаг сетки", bg="#82e0aa", fg="white", pady=5).pack(fill=tk.X, pady=(10,0))
        grid_step_frame = tk.Frame(right_frame, bg=self.COLOR_SIDEBAR_BG)
        grid_step_frame.pack(pady=5)
        for step in ["10", "15", "20", "30", "60"]:
            bg_color = "#3498db" if step == "30" else "#ecf0f1"
            fg_color = "white" if step == "30" else "black"
            tk.Button(grid_step_frame, text=step, bg=bg_color, fg=fg_color, width=3, relief=tk.FLAT).pack(side=tk.LEFT, padx=1)
            
        # Настройки количества дней
        tk.Label(right_frame, text="Количество дней", bg="#82e0aa", fg="white", pady=5).pack(fill=tk.X, pady=(10,0))
        days_frame = tk.Frame(right_frame, bg=self.COLOR_SIDEBAR_BG)
        days_frame.pack(pady=5)
        for day in ["1", "2", "3", "5", "7"]:
            bg_color = "#3498db" if day == "1" else "#ecf0f1"
            fg_color = "white" if day == "1" else "black"
            tk.Button(days_frame, text=day, bg=bg_color, fg=fg_color, width=3, relief=tk.FLAT).pack(side=tk.LEFT, padx=1)

    def create_center_schedule(self, parent):
        """Центральная часть - сетка расписания"""
        center_frame = tk.Frame(parent, bg="white", highlightbackground="#bdc3c7", highlightthickness=1)
        center_frame.pack(side=tk.LEFT, fill=tk.BOTH, expand=True)
        
        # Шапка расписания
        schedule_header = tk.Frame(center_frame, bg="#ecf0f1")
        schedule_header.pack(fill=tk.X)
        tk.Label(schedule_header, text="Запись на прием 18 января 2016 понедельник", font=("Arial", 10, "bold"), bg="#ecf0f1").pack(side=tk.LEFT, padx=10, pady=5)
        
        # Создаем таблицу на основе Canvas (для возможности позиционирования цветных блоков)
        # В более простом варианте можно использовать сетку из Frame (grid)
        schedule_grid = tk.Frame(center_frame, bg="white")
        schedule_grid.pack(fill=tk.BOTH, expand=True, padx=5, pady=5)
        
        doctors = ["Баранов И. Е.", "Тарасов Р. Т.", "Иванов П. В."]
        times = [f"{h:02d}:{m:02d}" for h in range(9, 20) for m in (0, 30)]
        
        # Рисуем заголовки колонок (Врачи)
        for col, doc in enumerate(doctors):
            tk.Label(schedule_grid, text=doc, borderwidth=1, relief="solid", bg="#f4f6f7").grid(row=0, column=col+1, sticky="nsew")
            schedule_grid.grid_columnconfigure(col+1, weight=1)
            
        # Рисуем строки времени и пустые ячейки
        for row, time in enumerate(times):
            tk.Label(schedule_grid, text=time, borderwidth=1, relief="solid", bg="#f4f6f7", width=6).grid(row=row+1, column=0, sticky="nsew")
            for col in range(len(doctors)):
                cell = tk.Frame(schedule_grid, borderwidth=1, relief="solid", bg="white", height=25)
                cell.grid(row=row+1, column=col+1, sticky="nsew")

        # --- Имитация приемов (разноцветные блоки из скриншота) ---
        # Формат: (ряд, колонка, rowspan, цвет, текст)
        appointments = [
            (3, 2, 2, "#1f77b4", "Иванов 10:30-11:30 (Неподтв.)"), # темно-синий
            (6, 2, 2, "#00bfff", "Иванов 12:00-13:00 (Подтв.)"),   # голубой
            (9, 2, 2, "#f39c12", "Иванов 13:30-14:30 (Пришел)"),   # оранжевый
            (12, 2, 2, "#82e0aa", "Иванов 15:00-16:00 (Выполнен)"),# зеленый
            (15, 2, 2, "#b2babb", "Иванов 16:30-17:30 (Отменен)"), # серый
            (18, 2, 2, "#f1948a", "Иванов 18:00-19:00 (Неявка)")   # красный
        ]
        
        for r, c, span, color, text in appointments:
            apt_lbl = tk.Label(schedule_grid, text=text, bg=color, fg="white", font=("Arial", 9))
            apt_lbl.grid(row=r+1, column=c+1, rowspan=span, sticky="nsew", padx=2, pady=2)


if name == "main":
    app = MedodsApp()
    app.mainloop()
