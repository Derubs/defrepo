import tkinter as tk
from tkinter import ttk, messagebox
import sqlite3
from datetime import datetime

# Константы темы
DARK_BG = "#1e1e1e"
DARK_FG = "#ffffff"
DARK_INPUT = "#333333"
ACCENT_COLOR = "#bb86fc"
STATUS_OPTIONS = ["Записан", "Подтвержден", "На приеме", "Закрыто", "Неявка"]

class ClinicApp:
    def __init__(self, root):
        self.root = root
        self.root.title("ИС 'Регистратура' v3.0 - Полное соответствие ТЗ")
        self.root.geometry("1100x850")
        self.root.configure(bg=DARK_BG)
        
        self.root.columnconfigure(0, weight=1)
        self.root.rowconfigure(0, weight=1)
        
        self.init_db()
        self.setup_styles()
        self.create_widgets()
        self.update_table()

    def init_db(self):
        conn = sqlite3.connect('clinic_final.db')
        cursor = conn.cursor()
        # Таблица согласно п. 3.1
        cursor.execute('''CREATE TABLE IF NOT EXISTS patients (
                            id INTEGER PRIMARY KEY, 
                            fio TEXT, dob TEXT, phone TEXT, address TEXT,
                            reg_date TEXT, medcards_qty INTEGER,
                            visit_date TEXT, visit_time TEXT,
                            assigned_exams TEXT, exam_results TEXT,
                            sick_leave TEXT, status TEXT)''')
        conn.commit()
        conn.close()

    def setup_styles(self):
        style = ttk.Style()
        style.theme_use('clam')
        style.configure("Treeview", background=DARK_INPUT, foreground=DARK_FG, fieldbackground=DARK_INPUT, borderwidth=0)
        style.map("Treeview", background=[('selected', ACCENT_COLOR)])
        style.configure("Treeview.Heading", background="#333333", foreground=DARK_FG)

    def create_widgets(self):
        self.main_frame = tk.Frame(self.root, bg=DARK_BG, padx=15, pady=15)
        self.main_frame.grid(row=0, column=0, sticky="nsew")
        self.main_frame.columnconfigure(0, weight=1)
        self.main_frame.columnconfigure(1, weight=1)
        self.main_frame.rowconfigure(3, weight=1)

        # --- ПАНЕЛЬ ПОИСКА (п. 3.2: Поиск) ---
        search_frame = tk.Frame(self.main_frame, bg=DARK_BG)
        search_frame.grid(row=0, column=0, columnspan=2, sticky="ew", pady=(0, 10))
        tk.Label(search_frame, text="🔍 Поиск (ФИО/Телефон):", bg=DARK_BG, fg=ACCENT_COLOR).pack(side="left")
        self.search_entry = tk.Entry(search_frame, bg=DARK_INPUT, fg=DARK_FG)
        self.search_entry.pack(side="left", padx=10, fill="x", expand=True)
        tk.Button(search_frame, text="Найти", command=self.search_data).pack(side="left")
        tk.Button(search_frame, text="Сброс", command=self.update_table).pack(side="left", padx=5)

        # --- ЛЕВАЯ КОЛОНКА: ДАННЫЕ ПАЦИЕНТА ---
        data_frame = tk.LabelFrame(self.main_frame, text="Регистрация (п. 3.1)", bg=DARK_BG, fg=ACCENT_COLOR, padx=10, pady=10)
        data_frame.grid(row=1, column=0, sticky="nsew", padx=5)

        self.fields = {}
        labels = [("ФИО", "fio"), ("Дата рожд.", "dob"), ("Телефон", "phone"), 
                  ("Адрес", "address"), ("Кол-во медкарт", "medcards"), 
                  ("Дата приема", "v_date"), ("Время приема", "v_time")]
        
        for i, (label, key) in enumerate(labels):
            tk.Label(data_frame, text=label, bg=DARK_BG, fg=DARK_FG).grid(row=i, column=0, sticky="w", pady=2)
            entry = tk.Entry(data_frame, bg=DARK_INPUT, fg=DARK_FG, insertbackground="white")
            entry.grid(row=i, column=1, pady=2, padx=5, sticky="ew")
            self.fields[key] = entry
        data_frame.columnconfigure(1, weight=1)

        # --- ПРАВАЯ КОЛОНКА: ОБСЛЕДОВАНИЯ И СТАТУС ---
        action_frame = tk.LabelFrame(self.main_frame, text="Обследования и Документы", bg=DARK_BG, fg=ACCENT_COLOR, padx=10, pady=10)
        action_frame.grid(row=1, column=1, sticky="nsew", padx=5)

        tk.Label(action_frame, text="Назначенные обследования:", bg=DARK_BG, fg=DARK_FG).pack(anchor="w")
        self.exams_vars = {t: tk.BooleanVar() for t in ["Кровь", "Моча", "Рентген", "УЗИ"]}
        for text, var in self.exams_vars.items():
            tk.Checkbutton(action_frame, text=text, variable=var, bg=DARK_BG, fg=DARK_FG, selectcolor=DARK_INPUT).pack(anchor="w")

        tk.Label(action_frame, text="Результаты обследований:", bg=DARK_BG, fg=DARK_FG, pady=5).pack(anchor="w")
        self.result_text = tk.Text(action_frame, height=3, bg=DARK_INPUT, fg=DARK_FG, borderwidth=0)
        self.result_text.pack(fill="x", padx=2)

        tk.Label(action_frame, text="Статус записи:", bg=DARK_BG, fg=DARK_FG).pack(anchor="w", pady=(5,0))
        self.status_combo = ttk.Combobox(action_frame, values=STATUS_OPTIONS, state="readonly")
        self.status_combo.set(STATUS_OPTIONS[0])
        self.status_combo.pack(fill="x")

        # --- КНОПКИ УПРАВЛЕНИЯ ---
        btn_frame = tk.Frame(self.main_frame, bg=DARK_BG)
        btn_frame.grid(row=2, column=0, columnspan=2, pady=15)

        tk.Button(btn_frame, text="💾 Регистрация", command=self.add_entry, bg="#388E3C", fg="white", width=15).pack(side="left", padx=5)
        tk.Button(btn_frame, text="🔄 Изменить", command=self.update_status, bg="#1976D2", fg="white", width=15).pack(side="left", padx=5)
        tk.Button(btn_frame, text="🗑 Удалить", command=self.delete_entry, bg="#D32F2F", fg="white", width=15).pack(side="left", padx=5)
        tk.Button(btn_frame, text="📊 Отчет (Приемы)", command=self.generate_report, bg="#FFA000", fg="black", width=18).pack(side="left", padx=5)

        # --- ТАБЛИЦА ---
        cols = ("id", "fio", "reg_date", "med", "v_date", "v_time", "status")
        self.tree = ttk.Treeview(self.main_frame, columns=cols, show="headings")
        titles = ["ID", "ФИО", "Дата Рег.", "Медкарт", "Дата пр.", "Время", "Статус"]
        for col, title in zip(cols, titles):
            self.tree.heading(col, text=title)
            self.tree.column(col, width=100)
        self.tree.grid(row=3, column=0, columnspan=2, sticky="nsew")

    def check_conflict(self, date, time):
        """п. 3.2: Резервирование времени без конфликтов"""
        conn = sqlite3.connect('clinic_final.db')
        cursor = conn.cursor()
        cursor.execute("SELECT id FROM patients WHERE visit_date=? AND visit_time=?", (date, time))
        conflict = cursor.fetchone()
        conn.close()
        return conflict

    def add_entry(self):
        if self.check_conflict(self.fields['v_date'].get(), self.fields['v_time'].get()):
            messagebox.showerror("Конфликт", "Это время уже занято другим пациентом!")
            return

        exams = ", ".join([t for t, v in self.exams_vars.items() if v.get()])
        reg_date = datetime.now().strftime("%d.%m.%Y")
        
        data = (
            self.fields['fio'].get(), self.fields['dob'].get(), self.fields['phone'].get(),
            self.fields['address'].get(), reg_date, self.fields['medcards'].get(),
            self.fields['v_date'].get(), self.fields['v_time'].get(),
            exams, self.result_text.get("1.0", "end-1c"), "Нет", self.status_combo.get()
        )
        
        conn = sqlite3.connect('clinic_final.db')
        cursor = conn.cursor()
        cursor.execute('''INSERT INTO patients (fio, dob, phone, address, reg_date, medcards_qty, 
                          visit_date, visit_time, assigned_exams, exam_results, sick_leave, status) 
                          VALUES (?,?,?,?,?,?,?,?,?,?,?,?)''', data)
        conn.commit()
        conn.close()
        self.update_table()

    def search_data(self):
        """п. 3.2: Поиск данных"""
        query = self.search_entry.get()
        for i in self.tree.get_children(): self.tree.delete(i)
        conn = sqlite3.connect('clinic_final.db')
        cursor = conn.cursor()
        cursor.execute("SELECT id, fio, reg_date, medcards_qty, visit_date, visit_time, status FROM patients WHERE fio LIKE ? OR phone LIKE ?", 
                       ('%'+query+'%', '%'+query+'%'))
        for row in cursor.fetchall():
            self.tree.insert("", "end", values=row)
        conn.close()

    def generate_report(self):
        """п. 3.2: Формирование отчетности"""
        today = datetime.now().strftime("%d.%m.%Y")
        conn = sqlite3.connect('clinic_final.db')
        cursor = conn.cursor()
        cursor.execute("SELECT visit_time, fio, status FROM patients WHERE visit_date=?", (self.fields['v_date'].get() or today,))
        rows = cursor.fetchall()
        conn.close()
        
        report = f"Список приемов на {self.fields['v_date'].get() or today}:\n\n"
        for r in rows:
            report += f"🕒 {r[0]} - {r[1]} [{r[2]}]\n"
        
        messagebox.showinfo("Лист приема для врача", report if rows else "На эту дату приемов нет.")

    def update_status(self):
        selected = self.tree.selection()
        if not selected: return
        p_id = self.tree.item(selected)['values'][0]
        exams = ", ".join([t for t, v in self.exams_vars.items() if v.get()])
        
        conn = sqlite3.connect('clinic_final.db')
        cursor = conn.cursor()
        cursor.execute('''UPDATE patients SET fio=?, phone=?, address=?, medcards_qty=?, 
                          visit_date=?, visit_time=?, assigned_exams=?, exam_results=?, status=? WHERE id=?''', 
                       (self.fields['fio'].get(), self.fields['phone'].get(), self.fields['address'].get(), 
                        self.fields['medcards'].get(), self.fields['v_date'].get(), self.fields['v_time'].get(), 
                        exams, self.result_text.get("1.0", "end-1c"), self.status_combo.get(), p_id))
        conn.commit()
        conn.close()
        self.update_table()

    def delete_entry(self):
        selected = self.tree.selection()
        if not selected: return
        p_id = self.tree.item(selected)['values'][0]
        conn = sqlite3.connect('clinic_final.db')
        cursor = conn.cursor()
        cursor.execute("DELETE FROM patients WHERE id=?", (p_id,))
        conn.commit()
        conn.close()
        self.update_table()

    def update_table(self):
        for i in self.tree.get_children(): self.tree.delete(i)
        conn = sqlite3.connect('clinic_final.db')
        cursor = conn.cursor()
        for row in cursor.execute("SELECT id, fio, reg_date, medcards_qty, visit_date, visit_time, status FROM patients"):
            self.tree.insert("", "end", values=row)
        conn.close()

if __name__ == "__main__":
    root = tk.Tk()
    app = ClinicApp(root)
    root.mainloop()
