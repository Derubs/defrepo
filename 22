class PatientsPage(tk.Frame):
    def __init__(self, parent):
        super().__init__(parent, bg=BG)
        self._build()

    def _build(self):
        top = tk.Frame(self, bg=BG)
        top.pack(fill="x", padx=24, pady=16)
        section_label(top, "Картотека пациентов").pack(side="left")
        styled_btn(top, "+ Добавить", self._open_add).pack(side="right")
        styled_btn(top, "🗑 Удалить", self._delete, color=DANGER).pack(side="right", padx=6)

        # Поиск
        sf = tk.Frame(self, bg=BG)
        sf.pack(fill="x", padx=24, pady=(0, 10))
        field_label(sf, "Поиск:").pack(side="left")
        self.search_var = tk.StringVar()
        self.search_var.trace("w", lambda *a: self.refresh())
        e = styled_entry(sf, textvariable=self.search_var, width=36)
        e.pack(side="left", padx=8)

        # Таблица
        tf = tk.Frame(self, bg=BG)
        tf.pack(fill="both", expand=True, padx=24, pady=(0, 16))
        cols = ("id","full_name","birth_date","diagnosis","phone","address")
        names = ("ID","ФИО","Дата рожд.","Диагноз","Телефон","Адрес")
        self.tree, sb = make_tree(tf, cols, names, heights=18)
        self.tree.pack(side="left", fill="both", expand=True)
        sb.pack(side="right", fill="y")

    def refresh(self):
        q = self.search_var.get().strip().lower()
        conn = sqlite3.connect(DB_PATH)
        rows = conn.execute("SELECT id,full_name,birth_date,diagnosis,phone,address FROM patients").fetchall()
        conn.close()
        self.tree.delete(*self.tree.get_children())
        for r in rows:
            if not q or any(q in str(v).lower() for v in r):
                self.tree.insert("", "end", values=r)

    def _open_add(self):
        PatientForm(self)

    def _delete(self):
        sel = self.tree.selection()
        if not sel:
            messagebox.showwarning("Удаление", "Выберите пациента")
            return
        pid = self.tree.item(sel[0])["values"][0]
        if messagebox.askyesno("Удаление", f"Удалить пациента ID {pid}?"):
            conn = sqlite3.connect(DB_PATH)
            conn.execute("DELETE FROM patients WHERE id=?", (pid,))
            conn.execute("DELETE FROM medcards WHERE patient_id=?", (pid,))
            conn.commit(); conn.close()
            self.refresh()

class PatientForm(tk.Toplevel):
    def __init__(self, caller):
        super().__init__()
        self.caller = caller
        self.title("Новый пациент")
        self.configure(bg=PANEL)
        self.geometry("420x360")
        self.resizable(False, False)
        fields = [("ФИО", "full_name"), ("Дата рождения (ГГГГ-ММ-ДД)", "birth_date"),
                  ("Диагноз", "diagnosis"), ("Телефон", "phone"), ("Адрес", "address")]
        self.vars = {}
        for lbl, key in fields:
            field_label(self, lbl).pack(padx=20, pady=(10, 2), anchor="w")
            v = tk.StringVar()
            self.vars[key] = v
            styled_entry(self, textvariable=v, width=46).pack(padx=20)
        styled_btn(self, "💾 Сохранить", self._save).pack(pady=18)

    def _save(self):
        d = {k: v.get().strip() for k, v in self.vars.items()}
        if not d["full_name"]:
            messagebox.showwarning("Ошибка", "Введите ФИО")
            return
        conn = sqlite3.connect(DB_PATH)
        c = conn.cursor()
        c.execute("INSERT INTO patients(full_name,birth_date,diagnosis,phone,address) VALUES(?,?,?,?,?)",
                  (d["full_name"], d["birth_date"], d["diagnosis"], d["phone"], d["address"]))
        pid = c.lastrowid
        c.execute("INSERT INTO medcards(patient_id,created_date) VALUES(?,?)",
                  (pid, datetime.date.today().isoformat()))
        conn.commit(); conn.close()
        self.caller.refresh()
        self.destroy()

