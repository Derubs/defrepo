import tkinter as tk
from tkinter import ttk, messagebox
import sqlite3

# Список доступных статусов
STATUS_OPTIONS = ["Не подтверждена", "Подтверждена", "На приеме", "Закрыто", "Неявка"]

def init_db():
    conn = sqlite3.connect('clinic.db')
    cursor = conn.cursor()
    # Добавляем колонку status, если её еще нет (через проверку или пересоздание)
    cursor.execute('''CREATE TABLE IF NOT EXISTS patients 
                      (id INTEGER PRIMARY KEY, fio TEXT, dob TEXT, phone TEXT, diagnosis TEXT, status TEXT)''')
    conn.commit()
    conn.close()

def add_patient():
    if fio_entry.get() == "":
        messagebox.showwarning("Ошибка", "Введите ФИО")
        return
    
    conn = sqlite3.connect('clinic.db')
    cursor = conn.cursor()
    cursor.execute("INSERT INTO patients (fio, dob, phone, diagnosis, status) VALUES (?, ?, ?, ?, ?)",
                   (fio_entry.get(), dob_entry.get(), phone_entry.get(), diag_entry.get(), status_combo.get()))
    conn.commit()
    conn.close()
    update_table()
    clear_entries()

def update_status():
    selected_item = tree.selection()
    if not selected_item:
        messagebox.showwarning("Ошибка", "Выберите запись в таблице")
        return
    
    patient_id = tree.item(selected_item)['values'][0]
    new_status = status_combo.get()
    
    conn = sqlite3.connect('clinic.db')
    cursor = conn.cursor()
    cursor.execute("UPDATE patients SET status = ? WHERE id = ?", (new_status, patient_id))
    conn.commit()
    conn.close()
    update_table()
    messagebox.showinfo("Успех", f"Статус обновлен на: {new_status}")

def update_table():
    for i in tree.get_children(): tree.delete(i)
    conn = sqlite3.connect('clinic.db')
    cursor = conn.cursor()
    # Выбираем все данные, включая статус
    for row in cursor.execute("SELECT * FROM patients"):
        tree.insert("", "end", values=row)
    conn.close()

def clear_entries():
    fio_entry.delete(0, tk.END)
    dob_entry.delete(0, tk.END)
    phone_entry.delete(0, tk.END)
    diag_entry.delete(0, tk.END)
    status_combo.set(STATUS_OPTIONS[0])

# GUI интерфейс
root = tk.Tk()
root.title("ИС 'Регистратура' v2.0")

# Фрейм для ввода данных
input_frame = tk.LabelFrame(root, text="Данные пациента", padx=10, pady=10)
input_frame.grid(row=0, column=0, padx=10, pady=10, sticky="nsew")

tk.Label(input_frame, text="ФИО:").grid(row=0, column=0, sticky="w")
fio_entry = tk.Entry(input_frame, width=30)
fio_entry.grid(row=0, column=1, pady=2)

tk.Label(input_frame, text="Дата рожд.:").grid(row=1, column=0, sticky="w")
dob_entry = tk.Entry(input_frame, width=30)
dob_entry.grid(row=1, column=1, pady=2)

tk.Label(input_frame, text="Телефон:").grid(row=2, column=0, sticky="w")
phone_entry = tk.Entry(input_frame, width=30)
phone_entry.grid(row=2, column=1, pady=2)

tk.Label(input_frame, text="Диагноз:").grid(row=3, column=0, sticky="w")
diag_entry = tk.Entry(input_frame, width=30)
diag_entry.grid(row=3, column=1, pady=2)

tk.Label(input_frame, text="Статус:").grid(row=4, column=0, sticky="w")
status_combo = ttk.Combobox(input_frame, values=STATUS_OPTIONS, state="readonly", width=27)
status_combo.current(0) # По умолчанию "Не подтверждена"
status_combo.grid(row=4, column=1, pady=5)

# Кнопки управления
btn_frame = tk.Frame(root)
btn_frame.grid(row=1, column=0, pady=5)

tk.Button(btn_frame, text="Новая запись", command=add_patient, bg="#e1f5fe").pack(side="left", padx=5)
tk.Button(btn_frame, text="Обновить статус", command=update_status, bg="#fff9c4").pack(side="left", padx=5)

# Таблица (Treeview)
columns = ("id", "fio", "dob", "phone", "diag", "status")
tree = ttk.Treeview(root, columns=columns, show="headings", height=10)

# Настройка заголовков и ширины колонок
headers = {"id": "ID", "fio": "ФИО", "dob": "Дата рожд.", "phone": "Телефон", "diag": "Диагноз", "status": "Статус"}
for col, name in headers.items():
    tree.heading(col, text=name)
    tree.column(col, width=100)

tree.grid(row=2, column=0, padx=10, pady=10)

init_db()
update_table()
root.mainloop()
