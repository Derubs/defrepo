def styled_entry(parent, **kw):
    e = tk.Entry(parent, bg=CARD, fg=TEXT, insertbackground=TEXT,
                 relief="flat", highlightthickness=1,
                 highlightbackground=BORDER, highlightcolor=ACCENT,
                 font=FONT_BODY, **kw)
    return e

def styled_btn(parent, text, cmd, color=ACCENT, **kw):
    b = tk.Button(parent, text=text, command=cmd,
                  bg=color, fg="#ffffff", activebackground=ACCENT2,
                  activeforeground="#ffffff", relief="flat",
                  font=("Courier New", 10, "bold"),
                  padx=14, pady=6, cursor="hand2", **kw)
    return b

def section_label(parent, text):
    return tk.Label(parent, text=text, bg=PANEL, fg=ACCENT,
                    font=FONT_H2, anchor="w")

def field_label(parent, text):
    return tk.Label(parent, text=text, bg=PANEL, fg=MUTED,
                    font=FONT_BODY, anchor="w")

def make_tree(parent, columns, col_names, heights=12):
    style = ttk.Style()
    style.theme_use("clam")
    style.configure("Custom.Treeview",
                    background=CARD, foreground=TEXT,
                    fieldbackground=CARD, rowheight=26,
                    font=FONT_BODY)
    style.configure("Custom.Treeview.Heading",
                    background=PANEL, foreground=ACCENT,
                    font=("Courier New", 9, "bold"), relief="flat")
    style.map("Custom.Treeview", background=[("selected", ACCENT2)])

    tree = ttk.Treeview(parent, columns=columns, show="headings",
                        style="Custom.Treeview", height=heights)
    for col, name in zip(columns, col_names):
        tree.heading(col, text=name)
        tree.column(col, anchor="w", width=120)

    sb = tk.Scrollbar(parent, orient="vertical", command=tree.yview,
                      bg=PANEL, troughcolor=BG)
    tree.configure(yscrollcommand=sb.set)
    return tree, sb

