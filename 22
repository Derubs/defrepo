        styled_entry(self, textvariable=self.exam_var, width=36).pack(padx=20)

        styled_btn(self, "✅ Сохранить", self._save).pack(pady=14)

    def _save(self):
        conn = sqlite3.connect(DB_PATH)
        conn.execute("UPDATE registry SET status=?, exam_results=? WHERE id=?",
                     (self.status_var.get(), self.exam_var.get(), self.rid))
        conn.commit(); conn.close()
        self.caller.refresh()
        self.destroy()

