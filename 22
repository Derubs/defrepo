class AppointmentsPage(tk.Frame):
    def __init__(self, parent):
        super().__init__(parent, bg=BG)
        self._build()

    def _build(self):
        top = tk.Frame(self, bg=BG)
        top.pack(fill="x", padx=24, pady=16)
        section_label(top, "Запись к врачу / Управление визитами").pack(side="left")
        styled_btn(top, "+ Записать", self._open_add).pack(side="right")
        styled_btn(top, "✏ Изменить статус", self._change_status, color=ACCENT2).pack(side="right", padx=6)

        # Фильтр по статусу
        ff = tk.Frame(self, bg=BG)
        ff.pack(fill="x", padx=24, pady=(0, 8))
        field_label(ff, "Фильтр:").pack(side="left")
        self.flt = tk.StringVar(value="Все")
        for v in ("Все", "active", "cancelled", "completed"):
            tk.Radiobutton(ff, text=v, variable=self.flt, value=v,
                           bg=BG, fg=TEXT, selectcolor=ACCENT,
                           activebackground=BG, command=self.refresh,
                           font=FONT_BODY).pack(side="left", padx=6)

        tf = tk.Frame(self, bg=BG)
        tf.pack(fill="both", expand=True, padx=24, pady=(0, 16))
        cols = ("id","patient","doctor","reg_date","appt_dt","status","exam")
        names = ("ID","Пациент","Врач","Дата рег.","Дата приёма","Статус","Результат обсл.")
        self.tree, sb = make_tree(tf, cols, names, heights=18)
        for col in cols:
            self.tree.column(col, width=100)
        self.tree.column("patient", width=160)
        self.tree.column("doctor", width=160)
        self.tree.pack(side="left", fill="both", expand=True)
        sb.pack(side="right", fill="y")

    def refresh(self):
        flt = self.flt.get()
        conn = sqlite3.connect(DB_PATH)
        sql = """SELECT r.id, p.full_name, d.full_name,
                        r.registration_date, r.appointment_datetime,
                        r.status, r.exam_results
                 FROM registry r
                 JOIN patients p ON p.id=r.patient_id
                 JOIN doctors  d ON d.id=r.doctor_id"""
        if flt != "Все":
            sql += f" WHERE r.status='{flt}'"
        rows = conn.execute(sql).fetchall()
        conn.close()
        self.tree.delete(*self.tree.get_children())
        for r in rows:
            tag = {"active": "act", "cancelled": "can", "completed": "com"}.get(r[5], "")
            self.tree.insert("", "end", values=r, tags=(tag,))
        self.tree.tag_configure("act", foreground=SUCCESS)
        self.tree.tag_configure("can", foreground=DANGER)
        self.tree.tag_configure("com", foreground=MUTED)

    def _open_add(self):
        AppointmentForm(self)

    def _change_status(self):
        sel = self.tree.selection()
        if not sel:
            messagebox.showwarning("", "Выберите запись")
            return
        rid = self.tree.item(sel[0])["values"][0]
        ChangeStatusForm(self, rid)

class AppointmentForm(tk.Toplevel):
    def __init__(self, caller):
        super().__init__()
        self.caller = caller
        self.title("Новая запись")
        self.configure(bg=PANEL)
        self.geometry("440x360")
        self.resizable(False, False)

        conn = sqlite3.connect(DB_PATH)
        self.patients = conn.execute("SELECT id,full_name FROM patients").fetchall()
        self.doctors  = conn.execute("SELECT id,full_name,reception_days,specialization FROM doctors").fetchall()
        conn.close()

        field_label(self, "Пациент:").pack(padx=20, pady=(14, 2), anchor="w")
        self.pat_cb = ttk.Combobox(self, values=[f"{p[0]} — {p[1]}" for p in self.patients],
                                   state="readonly", width=44, font=FONT_BODY)
        self.pat_cb.pack(padx=20)

        field_label(self, "Врач:").pack(padx=20, pady=(10, 2), anchor="w")
        self.doc_cb = ttk.Combobox(self, values=[f"{d[0]} — {d[1]} ({d[3]})" for d in self.doctors],
                                   state="readonly", width=44, font=FONT_BODY)
        self.doc_cb.pack(padx=20)
        self.doc_cb.bind("<<ComboboxSelected>>", self._show_days)

        self.days_lbl = field_label(self, "")
        self.days_lbl.pack(padx=20, anchor="w")

        field_label(self, "Дата приёма (ГГГГ-ММ-ДД ЧЧ:ММ):").pack(padx=20, pady=(10, 2), anchor="w")
        self.appt_var = tk.StringVar(value=datetime.datetime.now().strftime("%Y-%m-%d %H:%M"))
        styled_entry(self, textvariable=self.appt_var, width=44).pack(padx=20)

        styled_btn(self, "💾 Записать", self._save).pack(pady=18)

    def _show_days(self, *_):
        idx = self.doc_cb.current()
        if idx >= 0:
            self.days_lbl.configure(
                text=f"Приёмные дни: {self.doctors[idx][2]}",
                fg=SUCCESS)

    def _save(self):
        pi, di = self.pat_cb.current(), self.doc_cb.current()
        if pi < 0 or di < 0:
            messagebox.showwarning("Ошибка", "Выберите пациента и врача")
            return
        conn = sqlite3.connect(DB_PATH)
        conn.execute(
            "INSERT INTO registry(patient_id,doctor_id,registration_date,appointment_datetime,status) VALUES(?,?,?,?,?)",
            (self.patients[pi][0], self.doctors[di][0],
             datetime.date.today().isoformat(), self.appt_var.get(), "active"))
        conn.commit(); conn.close()
        self.caller.refresh()
        self.destroy()

