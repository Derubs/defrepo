        field_label(self, "Новый статус:").pack(padx=20, pady=(16, 4), anchor="w")
        self.status_var = tk.StringVar(value="active")
        for s in ("active", "cancelled", "completed"):
            tk.Radiobutton(self, text=s, variable=self.status_var, value=s,
                           bg=PANEL, fg=TEXT, selectcolor=ACCENT,
                           activebackground=PANEL, font=FONT_BODY).pack(padx=28, anchor="w")

        field_label(self, "Результат обследования:").pack(padx=20, pady=(12, 4), anchor="w")
