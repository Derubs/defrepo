DB_PATH = "polyclinic.db"

def init_db():
    conn = sqlite3.connect(DB_PATH)
    c = conn.cursor()
    # Пациенты: ФИО, дата рождения, диагноз, телефон, адрес
    c.execute("""CREATE TABLE IF NOT EXISTS patients (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        full_name TEXT NOT NULL,
        birth_date TEXT,
        diagnosis TEXT,
        phone TEXT,
        address TEXT
    )""")
    # Врачи: ФИО, приёмные дни, специализация, № кабинета
    c.execute("""CREATE TABLE IF NOT EXISTS doctors (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        full_name TEXT NOT NULL,
        reception_days TEXT,
        specialization TEXT,
        cabinet_number TEXT
    )""")
    # Регистратура: даты регистраций, кол-во медкарт, результаты обследований
    c.execute("""CREATE TABLE IF NOT EXISTS registry (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        patient_id INTEGER,
        doctor_id INTEGER,
        registration_date TEXT,
        appointment_datetime TEXT,
        status TEXT DEFAULT 'active',
        exam_results TEXT,
        FOREIGN KEY(patient_id) REFERENCES patients(id),
        FOREIGN KEY(doctor_id) REFERENCES doctors(id)
    )""")
    # Медкарты
    c.execute("""CREATE TABLE IF NOT EXISTS medcards (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        patient_id INTEGER UNIQUE,
        created_date TEXT,
        FOREIGN KEY(patient_id) REFERENCES patients(id)
    )""")
    conn.commit()

    # Демо-данные
    c.execute("SELECT COUNT(*) FROM doctors")
    if c.fetchone()[0] == 0:
        doctors = [
            ("Иванов Пётр Сергеевич", "Пн, Ср, Пт", "Терапевт", "101"),
            ("Смирнова Анна Владимировна", "Вт, Чт", "Кардиолог", "205"),
            ("Козлов Дмитрий Александрович", "Пн, Вт, Ср, Чт, Пт", "Хирург", "312"),
        ]
        c.executemany("INSERT INTO doctors(full_name,reception_days,specialization,cabinet_number) VALUES(?,?,?,?)", doctors)

    c.execute("SELECT COUNT(*) FROM patients")
    if c.fetchone()[0] == 0:
        patients = [
            ("Петрова Мария Ивановна", "1985-03-12", "Гипертония", "+7 900 111-22-33", "ул. Ленина 5"),
            ("Сидоров Алексей Николаевич", "1972-07-25", "Диабет II типа", "+7 900 444-55-66", "пр. Мира 18"),
        ]
        for p in patients:
            c.execute("INSERT INTO patients(full_name,birth_date,diagnosis,phone,address) VALUES(?,?,?,?,?)", p)
            pid = c.lastrowid
            c.execute("INSERT INTO medcards(patient_id,created_date) VALUES(?,?)",
                      (pid, datetime.date.today().isoformat()))

    conn.commit()
    conn.close()

